{
  "name": "W2Talent Hygiene — cron 180d/14d idempotente",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "cronExpression", "expression": "0 6 * * *", "triggerAtDay": 1 }] }
      },
      "id": "cron-daily-06",
      "name": "Cron diário 06:00 BRT",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "url": "={{ $env.BASE_URL || 'http://w2talent:3000' }}/api/cron/hygiene",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Authorization", "value": "=Bearer {{ $env.CRON_SECRET }}" }]
        },
        "options": { "retryOnFail": true, "timeout": 30000 }
      },
      "id": "http-hygiene",
      "name": "GET /api/cron/hygiene",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [320, 0],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "notes": "Idempotente via HygieneEvent (userId+marco+date). Retry 3x com backoff. WABA template aprovado; fora janela 24h fallback e-mail."
    },
    {
      "parameters": {
        "conditions": {
          "number": [{ "value1": "={{ $json.statusCode || 200 }}", "operation": "notEqual", "value2": 200 }]
        }
      },
      "id": "if-error",
      "name": "Erro? -> alerta",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [640, 0]
    },
    {
      "parameters": {
        "subject": "W2Talent hygiene cron falhou",
        "text": "=Hygiene falhou em {{ $now }} — status {{ $json.statusCode }} body={{ $json.body }}",
        "to": "={{ $env.ALERT_EMAIL }}"
      },
      "id": "alert-email",
      "name": "Alerta e-mail",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [960, 120]
    }
  ],
  "connections": {
    "Cron diário 06:00 BRT": { "main": [[{ "node": "GET /api/cron/hygiene", "type": "main", "index": 0 }]] },
    "GET /api/cron/hygiene": { "main": [[{ "node": "Erro? -> alerta", "type": "main", "index": 0 }]] },
    "Erro? -> alerta": { "main": [[], [{ "node": "Alerta e-mail", "type": "main", "index": 0 }]] }
  },
  "active": true,
  "settings": { "executionOrder": "v1" },
  "meta": {
    "description": "Varre expiresAt diariamente (CV 150/165/175 nudges, 180 arquiva, vaga D12 aviso D14 arquiva), dedupe idempotente, purge D+30 hard-delete, WABA 24h fallback e-mail.",
    "templates": ["w2talent_nudge_d150_v1", "w2talent_nudge_d165_v1", "w2talent_nudge_d175_v1", "w2talent_arquivado_v1", "w2talent_vaga_aviso_d12_v1"]
  }
}
